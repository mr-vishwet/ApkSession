*.pyc
.DS_Store

# --- added 2026-10-31 before initialising the repo ---
# Blanket rule: the granular patterns above do NOT cover sessions/*/export/evidences/,
# which mirrors unmasked client screens (logo, product name, real user names).
# Verified: `git add -A` would have staged 546 such files, 42 MB.
sessions/
*.fig
